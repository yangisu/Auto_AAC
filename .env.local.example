# Copy this file to .env.local for local development.
# Never commit .env.local. Rotate leaked keys immediately.

# Required: server-side OpenAI key for text and image generation.
OPENAI_API_KEY=

# Optional model overrides.
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=

# Optional public app URL, for example https://auto-aac.vercel.app
NEXT_PUBLIC_APP_URL=

# Required for Android App Links verification in production.
# Use the SHA-256 certificate fingerprint from Google Play App Signing.
# An optional upload certificate fingerprint may be added after a comma.
ANDROID_SHA256_CERT_FINGERPRINTS=
