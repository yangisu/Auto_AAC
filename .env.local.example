# Copy this file to .env.local for local development.
# Never commit .env.local. Rotate leaked keys immediately.

# Required: server-side OpenAI key for text and image generation.
OPENAI_API_KEY=

# Optional model overrides.
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=

# Optional public app URL, for example https://auto-aac.vercel.app
NEXT_PUBLIC_APP_URL=

# Optional until Google Play provides its distinct App Signing SHA-256 fingerprint.
# When available, add it here; separate multiple fingerprints with commas.
ANDROID_SHA256_CERT_FINGERPRINTS=
